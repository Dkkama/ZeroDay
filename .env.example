# Cursor User API Key from https://cursor.com/dashboard/api
CURSOR_API_KEY=crsr_...

# Optional. Must be an id from: python sdoc_eval/run.py --list-models
# Leave empty to use your Cursor account default.
# CURSOR_MODEL=gemini-3-flash

# Clerk console
# DEMO_EMAIL=clerk@zeroday.local
# DEMO_PASSWORD=clerk123
# LLM defaults to cursor. Vertex uses ADC / gcloud on project hackathon-2026-509207.
# json keeps the desk in app/backend/data/state.json. firestore uses the
# (default) database in that same Google project.
# STORE_BACKEND=firestore
# Optional. Cloud Scheduler header X-Cron-Secret for /api/cron/imap
# CRON_SECRET=
